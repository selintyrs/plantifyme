# Build artefacts
target/
target/site/
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# VCS / CI
.git/
.github/

# Secrets — must never enter the image
.env
.env.local
frontend/.env
frontend/.env.local

# Docs / coverage reports (irrelevant for runtime)
*.md
LICENSE
*.log
jacoco.exec
coverage/
reports/

# Existing static build output (will be regenerated by Stage 1)
src/main/resources/static/

# The Dockerfile itself (not needed inside the build context payload)
Dockerfile
.dockerignore
