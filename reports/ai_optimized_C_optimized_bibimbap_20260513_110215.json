  "instructions": [
    {
      "step": 1,
      "text": "Reis kochen. Tofu in Würfel schneiden, mit 2 EL Sojasauce und 1 EL Sesamöl marinieren und in Rapsöl knusprig braten."
    },
    {
      "step": 2,
      "text": "Karotten in feine Streifen schneiden und kurz in Sesamöl anbraten."
    },
    {
      "step": 3,
      "text": "Sojasprossen 1 Minute blanchieren, abschrecken und mit etwas Sesamöl und Salz vermengen."
    },
    {
      "step": 4,
      "text": "Spinat in kochendes Wasser geben, 30 Sekunden blanchieren, ausdrücken und mit Knoblauch, 1 EL Sojasauce und Sesam würzen."
    },
    {
      "step": 5,
      "text": "Pilze in Scheiben schneiden und in Rapsöl anbraten."
    },
    {
      "step": 6,
      "text": "Gurke in dünne Streifen schneiden."
    },
    {
      "step": 7,
      "text": "Für die Sauce: Sambal Oelek, restliche Sojasauce, Ahornsirup und 1 EL Wasser verrühren."
    },
    {
      "step": 8,
      "text": "Reis in Schüsseln verteilen. Gemüse, Tofu und Gurke sektorweise anrichten. Sauce darüber geben und mit Sesam bestreuen."
    }
  ],
