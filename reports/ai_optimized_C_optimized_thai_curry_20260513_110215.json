  "instructions": [
    {
      "step": 1,
      "text": "Jasminreis nach Packungsanleitung kochen."
    },
    {
      "step": 2,
      "text": "Tofu in Würfel schneiden. Paprika und Zucchetti in mundgerechte Stücke schneiden."
    },
    {
      "step": 3,
      "text": "Rapsöl in einem Wok erhitzen und Currypaste 1 Minute anrösten, bis sie duftet."
    },
    {
      "step": 4,
      "text": "Kokosmilch dazugiessen und umrühren. Tofu und Gemüse hinzufügen."
    },
    {
      "step": 5,
      "text": "10 Minuten bei mittlerer Hitze köcheln, bis das Gemüse gar aber noch bissfest ist."
    },
    {
      "step": 6,
      "text": "Mit Sojasauce und Ahornsirup abschmecken. Mit Basilikum und Reis servieren."
    }
  ],
