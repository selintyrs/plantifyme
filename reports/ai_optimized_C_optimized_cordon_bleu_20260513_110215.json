  "instructions": [
    {
      "step": 1,
      "text": "Eingeweichte Cashews mit Hefeflocken, Senf, Zitronensaft, Salz und etwas Wasser zu einem dicken Cashew-Käse mixen."
    },
    {
      "step": 2,
      "text": "Räuchertofu in dünne Scheiben schneiden."
    },
    {
      "step": 3,
      "text": "Seitan-Stücke aufschneiden wie eine Tasche. Mit Räuchertofu und Cashew-Käse füllen, dann mit Zahnstochern verschliessen."
    },
    {
      "step": 4,
      "text": "Drei flache Teller bereitstellen: 1) Mehl mit Salz und Pfeffer, 2) Pflanzenmilch, 3) Paniermehl."
    },
    {
      "step": 5,
      "text": "Gefüllte Seitan-Stücke erst in Mehl, dann in Pflanzenmilch, dann in Paniermehl wenden — gut andrücken."
    },
    {
      "step": 6,
      "text": "Rapsöl in einer Pfanne erhitzen und Cordon Bleu je Seite 4 Minuten goldbraun braten."
    },
    {
      "step": 7,
      "text": "Zahnstocher entfernen und mit Zitronenspalte servieren."
    }
  ],
