  "instructions": [
    {
      "step": 1,
      "text": "Ofen auf 180 Grad vorheizen. Eine quadratische Backform (ca. 20x20 cm) mit Backpapier auslegen."
    },
    {
      "step": 2,
      "text": "Schwarze Bohnen abgiessen und gründlich abspülen."
    },
    {
      "step": 3,
      "text": "Bohnen, Haferflocken, Kakao, Ahornsirup, Pflanzenmilch, geschmolzenes Kokosöl, Vanilleextrakt, Backpulver und Salz im Mixer zu einem glatten Teig pürieren."
    },
    {
      "step": 4,
      "text": "Schokolade grob hacken und unter den Teig heben."
    },
    {
      "step": 5,
      "text": "Teig in die Form geben und glattstreichen. 25-30 Minuten backen, bis die Oberfläche fest ist."
    },
    {
      "step": 6,
      "text": "Komplett auskühlen lassen, bevor du sie schneidest — sonst zerfallen sie."
    },
    {
      "step": 7,
      "text": "In 9 Quadrate schneiden und servieren."
    }
