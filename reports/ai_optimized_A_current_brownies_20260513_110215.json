  "instructions": [
    { "step": 1, "text": "Ofen auf 180°C vorheizen. Eine 20x20cm Backform mit Backpapier auslegen." },
    { "step": 2, "text": "Schwarze Bohnen gründlich abspülen und abtropfen lassen. Haferflocken in einem Mixer zu Mehl mahlen." },
    { "step": 3, "text": "Bohnen, Hafermehl, Kakaopulver, Ahornsirup, Pflanzenmilch, geschmolzenes Kokosöl und Vanilleextrakt in einem Mixer pürieren bis eine glatte Masse entsteht." },
    { "step": 4, "text": "Backpulver und Salz unterrühren. Die gehackte Schokolade vorsichtig unterheben." },
    { "step": 5, "text": "Teig in die vorbereitete Form geben und gleichmässig verstreichen." },
    { "step": 6, "text": "25-30 Minuten backen, bis ein Zahnstocher noch leicht feucht herauskommt. Nicht überbacken!" },
    { "step": 7, "text": "Vollständig abkühlen lassen, bevor die Brownies geschnitten werden. In Quadrate schneiden und servieren." }
