  "instructions": [
    { "step": 1, "text": "Cashews 15 Minuten in heissem Wasser einweichen. Spaghetti nach Packungsanweisung in Salzwasser kochen." },
    { "step": 2, "text": "Räuchertofu in kleine Würfel schneiden. Knoblauch fein hacken." },
    { "step": 3, "text": "Eingeweichte Cashews mit Pflanzenmilch, Hefeflocken, Kurkuma, Salz und Pfeffer in einem Mixer zu einer cremigen Sauce pürieren." },
    { "step": 4, "text": "Olivenöl in einer grossen Pfanne erhitzen. Tofu-Würfel darin 3-4 Minuten goldbraun anbraten." },
    { "step": 5, "text": "Knoblauch zu den Tofu-Würfeln geben und 1 Minute mitbraten." },
    { "step": 6, "text": "Abgetropfte Spaghetti zur Pfanne geben. Cashew-Sauce unterrühren und bei niedriger Hitze 2 Minuten schwenken." },
    { "step": 7, "text": "Mit frisch gemahlenem Pfeffer abschmecken und sofort servieren." }
