  "instructions": [
    { "step": 1, "text": "Cashews 30 Minuten in heissem Wasser einweichen, dann abgiessen." },
    { "step": 2, "text": "Räuchertofu in dünne Scheiben schneiden." },
    { "step": 3, "text": "Cashews mit 100ml Pflanzenmilch, Hefeflocken, Senf, Salz und Pfeffer zu einer cremigen Sauce pürieren." },
    { "step": 4, "text": "Seitan vorsichtig horizontal aufschneiden, aber nicht ganz durchschneiden, sodass eine Tasche entsteht." },
    { "step": 5, "text": "Die Seitantaschen mit Tofuscheiben und Cashew-Sauce füllen, dann mit Zahnstochern verschliessen." },
    { "step": 6, "text": "Drei Schalen vorbereiten: Mehl mit Salz und Pfeffer, restliche Pflanzenmilch und Paniermehl." },
    { "step": 7, "text": "Gefüllten Seitan erst in Mehl, dann in Pflanzenmilch und zuletzt in Paniermehl wenden." },
    { "step": 8, "text": "Öl in einer Pfanne erhitzen und die panierten Schnitzel von beiden Seiten 4-5 Minuten goldbraun braten." },
    { "step": 9, "text": "Mit Zitronenspalten servieren und heiss geniessen." }
