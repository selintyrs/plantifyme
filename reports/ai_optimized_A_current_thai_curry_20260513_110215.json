  "instructions": [
    { "step": 1, "text": "Jasminreis nach Packungsanweisung kochen." },
    { "step": 2, "text": "Tofu in Würfel schneiden. Paprika in Streifen und Zucchetti in Scheiben schneiden." },
    { "step": 3, "text": "Rapsöl in einer grossen Pfanne erhitzen. Tofu darin goldbraun anbraten und herausnehmen." },
    { "step": 4, "text": "Currypaste in der Pfanne kurz anrösten, dann Kokosmilch dazugiessen." },
    { "step": 5, "text": "Paprika und Zucchetti hinzufügen und 5 Minuten köcheln lassen." },
    { "step": 6, "text": "Tofu wieder hinzufügen. Mit Sojasauce und Ahornsirup würzen." },
    { "step": 7, "text": "Frisches Basilikum unterrühren und mit dem Jasminreis servieren." }
  ],
