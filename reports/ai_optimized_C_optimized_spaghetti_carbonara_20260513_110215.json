  "instructions": [
    {
      "step": 1,
      "text": "Cashews mindestens 4 Stunden einweichen. Abgiessen und mit Pflanzenmilch, Hefeflocken, Kurkuma und Salz cremig mixen."
    },
    {
      "step": 2,
      "text": "Spaghetti nach Packungsanleitung al dente kochen. Etwas Kochwasser aufheben."
    },
    {
      "step": 3,
      "text": "Räuchertofu in kleine Würfel schneiden und in Olivenöl knusprig braten."
    },
    {
      "step": 4,
      "text": "Knoblauch fein hacken und kurz mitbraten."
    },
    {
      "step": 5,
      "text": "Hitze reduzieren, Spaghetti und Cashew-Sauce in die Pfanne geben. Mit etwas Kochwasser cremig rühren."
    },
    {
      "step": 6,
      "text": "Mit Pfeffer und Hefeflocken servieren."
    }
