  "instructions": [
    { "step": 1, "text": "Jasminreis nach Packungsanleitung kochen und warm halten." },
    { "step": 2, "text": "Tofu in Würfel schneiden und mit 2 EL Sojasauce, 1 TL Ahornsirup und gehacktem Knoblauch marinieren." },
    { "step": 3, "text": "Karotten in dünne Streifen schneiden und in 1 EL Rapsöl 3-4 Minuten anbraten. Mit Salz würzen." },
    { "step": 4, "text": "Champignons in Scheiben schneiden und in derselben Pfanne 4-5 Minuten braten." },
    { "step": 5, "text": "Spinat kurz blanchieren, ausdrücken und mit 1 EL Sojasauce und 1 EL Sesamöl würzen." },
    { "step": 6, "text": "Sojasprossen 1-2 Minuten in kochendem Wasser blanchieren und abtropfen lassen." },
    { "step": 7, "text": "Gurke in dünne Scheiben schneiden und leicht salzen." },
    { "step": 8, "text": "Marinierten Tofu in 2 EL Rapsöl goldbraun braten." },
    { "step": 9, "text": "Sauce aus restlicher Sojasauce, Sambal Oelek, restlichem Ahornsirup und Sesamöl mischen." },
    { "step": 10, "text": "Reis in Schüsseln verteilen, Gemüse und Tofu darauf anrichten. Mit Sesam bestreuen und Sauce servieren." }
  ],
